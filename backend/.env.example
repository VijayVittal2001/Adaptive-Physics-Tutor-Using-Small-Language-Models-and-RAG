HOST=0.0.0.0
PORT=8000
FRONTEND_URL=http://localhost:5173
AUTH_SECRET=change-this-local-dev-secret
ACCESS_TOKEN_DAYS=7
REQUIRE_EMAIL_VERIFICATION=false

ADMIN_EMAIL=admin@physicsrag.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Physics Tutor Administrator

USE_OLLAMA=true
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b

# Recommended real local embedding model. Pull once: ollama pull nomic-embed-text
EMBEDDING_PROVIDER=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text

# Fallback embedding if Ollama embedding model is not available
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=16

CHUNK_SIZE=700
CHUNK_OVERLAP=180
RETRIEVAL_TOP_K=7
MAX_UPLOAD_MB=80
MAX_VIDEO_UPLOAD_MB=400

# Hugging Face Settings
HUGGINGFACE_TOKEN=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-72B-Instruct
